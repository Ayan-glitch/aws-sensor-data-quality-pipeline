# --- Python ---
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/

# --- Secrets / environment config ---
# Never commit real credentials or a filled-in env file.
# Only .env.example (with placeholder values) should ever be tracked.
.env
.env.*
!.env.example
*.pem
*.key
aws_credentials*
credentials.json

# --- Generated / working data (NOT source data) ---
# data/sample/ IS tracked on purpose -- it's the fixed, deterministic synthetic
# input everything else is built from, and the whole point of committing it is
# that a fresh clone can reproduce the full pipeline without regenerating it.
# data/local/ and data/quarantine/ are pipeline OUTPUT, regenerated by running
# the pipeline -- committing them would mean tracking derived data as if it
# were source, and they'd go stale the moment the code changes.
data/local/
data/quarantine/
output/bronze/
output/silver/
output/gold/

# --- Infrastructure state (future AWS phases) ---
# Terraform/CDK state files can contain resource IDs, ARNs, and sometimes
# sensitive outputs -- never belongs in git, even for a personal AWS account.
*.tfstate
*.tfstate.*
.terraform/
cdk.out/
.aws-sam/

# --- Logs ---
*.log
logs/

# --- OS / editor junk ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Jupyter (if any exploratory notebooks get added later) ---
.ipynb_checkpoints/
